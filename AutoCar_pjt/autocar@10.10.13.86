import cv2, os
from datetime import datetime

# 카메라 열기 (0은 기본 카메라)
cap = cv2.VideoCapture(0)

if not cap.isOpened():
    print("카메라를 열 수 없습니다.")
else:
    while True:
        # 프레임 읽기
        ret, frame = cap.read()

        if not ret:
            print("프레임을 읽을 수 없습니다.")
            break

        # 영상을 윈도우 창에 표시
        cv2.imshow('Camera Feed', frame)

        # 'q' 키를 누르면 종료
        if cv2.waitKey(1) & 0xFF == ord('q'):
            break

                # 마우스 클릭 이벤트 처리
        def save_image(event, x, y, flags, param):
            if event == cv2.EVENT_LBUTTONDOWN:  # 왼쪽 클릭
                dt = datetime.now()
                filename = os.path.join('jpg_data', f'{x}_{y}_{dt.year}-{dt.month}-{dt.day} {dt.hour}:{dt.minute}:{dt.second}.jpg')
                cv2.imwrite(filename, frame)
                print(f"사진이 저장되었습니다: {filename}")

        # 마우스 클릭 이벤트 등록
        cv2.setMouseCallback('Camera Feed', save_image, param=None)

# 카메라 해제 및 모든 창 닫기
cap.release()
cv2.destroyAllWindows()
